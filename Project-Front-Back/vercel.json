{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/admin-page/(.*)",
      "dest": "Front End/admin-page/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "Front End/main-page/$1",
      "continue": true
    },
    {
      "src": "/",
      "dest": "Front End/main-page/index.html"
    }
  ]
}