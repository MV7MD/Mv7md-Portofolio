{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/admin-page/(.*)",
      "dest": "/Front End/admin-page/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/Front End/main-page/index.html"
    }
  ]
}