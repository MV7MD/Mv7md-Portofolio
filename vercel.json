{
  "version": 2,
  "builds": [
    {
      "src": "Project-Front-Back/server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "Project-Front-Back/server.js" },
    { "source": "/dashboard", "destination": "Project-Front-Back/server.js" },
    { "source": "/", "destination": "Project-Front-Back/server.js" },
    { "source": "/(.*)", "destination": "Project-Front-Back/server.js" }
  ]
}